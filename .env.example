# =======================================================
# Comizely E-Commerce Platform - Frontend Environment Config
# =======================================================

# 1. Backend API Base URL
# When your backend API is running, point this to its root endpoint:
VITE_API_BASE_URL=http://localhost:5000/api

# 2. Mock API Toggle
# Set to "false" when you want all services to call your real backend API.
# Set to "true" (default) to run with in-memory / localStorage mock data.
VITE_USE_MOCK_API=true
